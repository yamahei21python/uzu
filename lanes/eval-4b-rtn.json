{
  "lane": "eval-4b-rtn",
  "model": {
    "hf_repo": "huihui-ai/Huihui-Qwen3.5-4B-Claude-4.6-Opus-abliterated",
    "spec_name": "Qwen3.5-4B",
    "bf16_dir": "bf16-4b-lalamo",
